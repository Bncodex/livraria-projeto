# ============================================
# Configuração da Aplicação (NestJS)
# ============================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:4200

# ============================================
# Banco de Dados — MongoDB Atlas (Mongoose)
# ============================================
# Substitua pelos dados do seu cluster no MongoDB Atlas quando for ativar a conexão real:
MONGODB_URI=mongodb+srv://<USUARIO>:<SENHA>@<CLUSTER>.mongodb.net/universo_literario?retryWrites=true&w=majority&appName=UniversoLiterario
MONGODB_DB_NAME=universo_literario

# ============================================
# Autenticação JWT + Cookies HttpOnly
# ============================================
JWT_SECRET=troque-por-uma-chave-secreta-forte-em-producao
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=troque-por-outra-chave-secreta-forte-para-refresh
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# ============================================
# Rate Limiting (Proteção contra abuso / DDoS)
# ============================================
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ============================================
# Edge Runtime (Opcional - chave para validação na borda)
# ============================================
EDGE_API_KEY=opcional-chave-para-rotas-edge
